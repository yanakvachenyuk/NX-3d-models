from __future__ import annotations

from .base import Profile
from .curves import Line
from .geometry import (
    rectangle_points,
    equilateral_triangle_points,
    trapezoid_points,
)


class Rectangle(Profile):
    """
    Прямоугольник.

    Parameters
    ----------
    width : float
        Ширина.

    height : float
        Высота.

    center : tuple(float, float)
        Координаты центра.
    """

    def __init__(
        self,
        workPart,
        width: float,
        height: float,
        center=(0.0, 0.0)
    ):

        self.width = width
        self.height = height
        self.center = center

        p1, p2, p3, p4 = rectangle_points(
            width,
            height,
            center
        )

        l1 = Line(workPart, p1, p2)
        l2 = Line(workPart, p2, p3)
        l3 = Line(workPart, p3, p4)
        l4 = Line(workPart, p4, p1)

        self.lines = [
            l1,
            l2,
            l3,
            l4
        ]

        curves = []

        for line in self.lines:
            curves.extend(line.curves)

        super().__init__(curves)


class Square(Rectangle):
    """
    Квадрат.
    """

    def __init__(
        self,
        workPart,
        side: float,
        center=(0.0, 0.0)
    ):

        self.side = side

        super().__init__(
            workPart,
            width=side,
            height=side,
            center=center
        )


class EquilateralTriangle(Profile):
    """
    Равносторонний треугольник.
    """

    def __init__(
        self,
        workPart,
        side: float,
        center=(0.0, 0.0)
    ):

        self.side = side
        self.center = center

        p1, p2, p3 = equilateral_triangle_points(
            side,
            center
        )

        l1 = Line(workPart, p1, p2)
        l2 = Line(workPart, p2, p3)
        l3 = Line(workPart, p3, p1)

        self.lines = [
            l1,
            l2,
            l3
        ]

        curves = []

        for line in self.lines:
            curves.extend(line.curves)

        super().__init__(curves)


class Trapezoid(Profile):
    """
    Равнобедренная трапеция.

    Parameters
    ----------
    bottom : float
        Нижнее основание.

    top : float
        Верхнее основание.

    height : float
        Высота.
    """

    def __init__(
        self,
        workPart,
        bottom: float,
        top: float,
        height: float,
        center=(0.0, 0.0)
    ):

        self.bottom = bottom
        self.top = top
        self.height = height
        self.center = center

        p1, p2, p3, p4 = trapezoid_points(
            bottom,
            top,
            height,
            center
        )

        l1 = Line(workPart, p1, p2)
        l2 = Line(workPart, p2, p3)
        l3 = Line(workPart, p3, p4)
        l4 = Line(workPart, p4, p1)

        self.lines = [
            l1,
            l2,
            l3,
            l4
        ]

        curves = []

        for line in self.lines:
            curves.extend(line.curves)

        super().__init__(curves)


