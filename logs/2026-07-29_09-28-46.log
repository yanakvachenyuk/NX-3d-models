from math import sqrt
from typing import Tuple

Point = Tuple[float, float, float]


def rectangle_points(
    width: float,
    height: float,
    center=(0.0, 0.0)
) -> tuple[Point, Point, Point, Point]:

    cx, cy = center

    x1 = cx - width / 2
    x2 = cx + width / 2

    y1 = cy - height / 2
    y2 = cy + height / 2

    return (

        (x1, y1, 0.0),

        (x2, y1, 0.0),

        (x2, y2, 0.0),

        (x1, y2, 0.0)

    )


def equilateral_triangle_points(
    side: float,
    center=(0.0, 0.0)
) -> tuple[Point, Point, Point]:

    cx, cy = center

    h = side * sqrt(3) / 2

    return (

        (
            cx - side / 2,
            cy - h / 3,
            0.0
        ),

        (
            cx + side / 2,
            cy - h / 3,
            0.0
        ),

        (
            cx,
            cy + 2 * h / 3,
            0.0
        )

    )


def trapezoid_points(
    bottom: float,
    top: float,
    height: float,
    center=(0.0, 0.0)
) -> tuple[Point, Point, Point, Point]:

    cx, cy = center

    return (

        (
            cx - bottom / 2,
            cy - height / 2,
            0.0
        ),

        (
            cx + bottom / 2,
            cy - height / 2,
            0.0
        ),

        (
            cx + top / 2,
            cy + height / 2,
            0.0
        ),

        (
            cx - top / 2,
            cy + height / 2,
            0.0
        )

    )


