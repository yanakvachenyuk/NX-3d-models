from __future__ import annotations

from .base import Profile
from .curves import Line
from .geometry import (
    rectangle_points,
    equilateral_triangle_points,
    triangle_by_3_sides,
    triangle_by_2_sides_and_angle,
    triangle_by_2_angles_and_side,
    isosceles_triangle_by_sides,
    isosceles_triangle_by_angle_and_side,
    isosceles_triangle_by_side_and_angle,
    right_triangle_by_sides,
    trapezoid_points,
)


class Rectangle(Profile):
    """
    Прямоугольник.

    Parameters
    ----------
    width : float
        Ширина.
    height : float
        Высота.
    center : tuple(float, float)
        Координаты центра.
    """

    def __init__(
        self,
        workPart,
        width: float,
        height: float,
        center=(0.0, 0.0)
    ):
        self.width = width
        self.height = height
        self.center = center

        p1, p2, p3, p4 = rectangle_points(width, height, center)

        l1 = Line(workPart, p1, p2)
        l2 = Line(workPart, p2, p3)
        l3 = Line(workPart, p3, p4)
        l4 = Line(workPart, p4, p1)

        self.lines = [l1, l2, l3, l4]
        curves = []
        for line in self.lines:
            curves.extend(line.curves)
        super().__init__(curves)


class Square(Rectangle):
    """
    Квадрат.
    """

    def __init__(
        self,
        workPart,
        side: float,
        center=(0.0, 0.0)
    ):
        self.side = side
        super().__init__(workPart, width=side, height=side, center=center)


class EquilateralTriangle(Profile):
    """
    Равносторонний треугольник по стороне.
    """
    
    def __init__(
        self,
        workPart,
        side: float,
        center=(0.0, 0.0)
    ):
        self.side = side
        self.center = center
        
        p1, p2, p3 = equilateral_triangle_points(side, center)
        
        l1 = Line(workPart, p1, p2)
        l2 = Line(workPart, p2, p3)
        l3 = Line(workPart, p3, p1)
        
        self.lines = [l1, l2, l3]
        curves = []
        for line in self.lines:
            curves.extend(line.curves)
        super().__init__(curves)


class TriangleBy3Sides(Profile):
    """
    Треугольник по трем сторонам.
    
    Parameters
    ----------
    side_a : float
        Первая сторона.
    side_b : float
        Вторая сторона.
    side_c : float
        Третья сторона.
    """
    
    def __init__(
        self,
        workPart,
        side_a: float,
        side_b: float,
        side_c: float,
        center=(0.0, 0.0)
    ):
        p1, p2, p3 = triangle_by_3_sides(side_a, side_b, side_c, center)
        
        l1 = Line(workPart, p1, p2)
        l2 = Line(workPart, p2, p3)
        l3 = Line(workPart, p3, p1)
        
