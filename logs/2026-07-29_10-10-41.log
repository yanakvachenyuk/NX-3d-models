from math import sqrt, cos, sin, radians
from typing import Tuple

Point = Tuple[float, float, float]


def rectangle_points(
    width: float,
    height: float,
    center=(0.0, 0.0)
) -> tuple[Point, Point, Point, Point]:
    cx, cy = center
    x1 = cx - width / 2
    x2 = cx + width / 2
    y1 = cy - height / 2
    y2 = cy + height / 2
    return (
        (x1, y1, 0.0),
        (x2, y1, 0.0),
        (x2, y2, 0.0),
        (x1, y2, 0.0)
    )


def equilateral_triangle_points(
    side: float,
    center=(0.0, 0.0)
) -> tuple[Point, Point, Point]:
    cx, cy = center
    h = side * sqrt(3) / 2
    return (
        (cx - side / 2, cy - h / 3, 0.0),
        (cx + side / 2, cy - h / 3, 0.0),
        (cx, cy + 2 * h / 3, 0.0)
    )


def triangle_by_3_sides(
    side_a: float,
    side_b: float,
    side_c: float,
    center=(0.0, 0.0)
) -> tuple[Point, Point, Point]:
    """Создает треугольник по трем сторонам"""
    # Проверка существования треугольника
    if (side_a + side_b <= side_c) or (side_a + side_c <= side_b) or (side_b + side_c <= side_a):
        raise ValueError("Треугольник с такими сторонами не существует")
    
    cx, cy = center
    
    # Первая вершина в центре внизу
    p1 = (cx - side_a / 2, cy - side_b / 2, 0.0)
    
    # Вторая вершина
    p2 = (cx + side_a / 2, cy - side_b / 2, 0.0)
    
    # Третья вершина вычисляется по теореме косинусов
    # Угол при вершине p1 между сторонами side_a и side_b
    cos_angle = (side_a**2 + side_b**2 - side_c**2) / (2 * side_a * side_b)
    angle = cos_angle if -1 <= cos_angle <= 1 else 0
    
    # Высота треугольника
    h = side_a * sqrt(1 - cos_angle**2) if 0 <= cos_angle <= 1 else side_b
    
    # Смещение третьей вершины
    dx = side_a * cos_angle
    dy = side_a * sqrt(1 - cos_angle**2)
    
    p3 = (cx + dx - side_a / 2, cy + dy - side_b / 2, 0.0)
    
    return (p1, p2, p3)


def triangle_by_2_sides_and_angle(
    side_a: float,
    side_b: float,
    angle_ab: float,  # Угол между сторонами a и b в градусах
    center=(0.0, 0.0)
) -> tuple[Point, Point, Point]:
    """Создает треугольник по двум сторонам и углу между ними"""
    cx, cy = center
    angle_rad = radians(angle_ab)
    
    # Первая вершина
    p1 = (cx - side_a / 2, cy - side_b / 2, 0.0)
    
    # Вторая вершина (по стороне a)
    p2 = (cx + side_a / 2, cy - side_b / 2, 0.0)
    
    # Третья вершина (по стороне b под углом)
    dx = side_b * cos(angle_rad)
    dy = side_b * sin(angle_rad)
    
    p3 = (cx - side_a / 2 + dx, cy - side_b / 2 + dy, 0.0)
    
    return (p1, p2, p3)


def triangle_by_2_angles_and_side(
    angle_a: float,  # Угол при вершине A в градусах
    angle_b: float,  # Угол при вершине B в градусах
    side_ab: float,  # Сторона между вершинами A и B
    center=(0.0, 0.0)
) -> tuple[Point, Point, Point]:
    """Создает треугольник по двум углам и стороне между ними"""
    # Проверка суммы углов
    if angle_a + angle_b >= 180:
        raise ValueError("Сумма двух углов должна быть меньше 180 градусов")
    
    cx, cy = center
    angle_c = 180 - angle_a - angle_b
    
    # Переводим в радианы
    a_rad = radians(angle_a)
    b_rad = radians(angle_b)
    c_rad = radians(angle_c)
    
    # Вычисляем стороны по теореме синусов
    side_bc = side_ab * sin(a_rad) / sin(c_rad)
    side_ac = side_ab * sin(b_rad) / sin(c_rad)
    
    # Строим треугольник
    p1 = (cx - side_ab / 2, cy - side_ac / 2, 0.0)
    p2 = (cx + side_ab / 2, cy - side_ac / 2, 0.0)
    
    # Вычисляем координаты третьей вершины
    h = side_ac * sin(a_rad)
    dx = side_ac * cos(a_rad)
    
    p3 = (cx - side_ab / 2 + dx, cy - side_ac / 2 + h, 0.0)
    
    return (p1, p2, p3)


def isosceles_triangle_by_sides(
    base: float,
    equal_side: float,
    center=(0.0, 0.0)
) -> tuple[Point, Point, Point]:
    """Создает равнобедренный треугольник по основанию и равным сторонам"""
    # Проверка существования
    if equal_side * 2 <= base:
        raise ValueError("Равные стороны слишком малы для такого основания")
    
    cx, cy = center
    
    # Высота треугольника
    h = sqrt(equal_side**2 - (base/2)**2)
    
    p1 = (cx - base / 2, cy - h / 3, 0.0)
    p2 = (cx + base / 2, cy - h / 3, 0.0)
    p3 = (cx, cy + 2 * h / 3, 0.0)
    
    return (p1, p2, p3)


def isosceles_triangle_by_angle_and_side(
    base: float,
    angle_at_base: float,  # Угол при основании в градусах
    center=(0.0, 0.0)
) -> tuple[Point, Point, Point]:
    """Создает равнобедренный треугольник по основанию и углу при основании"""
    angle_rad = radians(angle_at_base)
    
    # Высота треугольника
    h = (base / 2) * tan(angle_rad)
    
    cx, cy = center
    
    p1 = (cx - base / 2, cy - h / 3, 0.0)
    p2 = (cx + base / 2, cy - h / 3, 0.0)
    p3 = (cx, cy + 2 * h / 3, 0.0)
    
    return (p1, p2, p3)


def isosceles_triangle_by_side_and_angle(
    equal_side: float,
    angle_at_vertex: float,  # Угол при вершине в градусах
    center=(0.0, 0.0)
) -> tuple[Point, Point, Point]:
    """Создает равнобедренный треугольник по равной стороне и углу при вершине"""
    angle_rad = radians(angle_at_vertex)
    
    # Основание треугольника
    base = 2 * equal_side * sin(angle_rad / 2)
    
    # Высота треугольника
    h = equal_side * cos(angle_rad / 2)
    
    cx, cy = center
    
    p1 = (cx - base / 2, cy - h / 3, 0.0)
    p2 = (cx + base / 2, cy - h / 3, 0.0)
    p3 = (cx, cy + 2 * h / 3, 0.0)
    
    return (p1, p2, p3)


def right_triangle_by_sides(
    leg_a: float,
    leg_b: float,
    center=(0.0, 0.0)
) -> tuple[Point, Point, Point]:
    """Создает прямоугольный треугольник по двум катетам"""
    cx, cy = center
    
    p1 = (cx - leg_a / 2, cy - leg_b / 2, 0.0)
    p2 = (cx + leg_a / 2, cy - leg_b / 2, 0.0)
    p3 = (cx - leg_a / 2, cy + leg_b / 2, 0.0)
    
    return (p1, p2, p3)


def trapezoid_points(
    bottom: float,
    top: float,
    height: float,
    center=(0.0, 0.0)
) -> tuple[Point, Point, Point, Point]:
    cx, cy = center
    return (
        (cx - bottom / 2, cy - height / 2, 0.0),
        (cx + bottom / 2, cy - height / 2, 0.0),
        (cx + top / 2, cy + height / 2, 0.0),
        (cx - top / 2, cy + height / 2, 0.0)
    )


