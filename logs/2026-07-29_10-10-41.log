triangle_profile = Profile(workPart)
triangle_profile.lines = [
    Line(workPart, (0, 0), (30, 0)),
    Line(workPart, (30, 0), (45, 40)),
    Line(workPart, (45, 40), (0, 0))
]

# Создаем профиль отверстия
circle_profile = Profile(workPart)
circle_center = (45 / 2, 40 / 2)
radius = 5
