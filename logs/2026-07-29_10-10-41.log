    Равнобедренная трапеция.

    Parameters
    ----------
    bottom : float
        Нижнее основание.
    top : float
        Верхнее основание.
    height : float
        Высота.
    """

    def __init__(
        self,
        workPart,
        bottom: float,
        top: float,
        height: float,
        center=(0.0, 0.0)
    ):
        self.bottom = bottom
        self.top = top
        self.height = height
        self.center = center

        p1, p2, p3, p4 = trapezoid_points(bottom, top, height, center)

        l1 = Line(workPart, p1, p2)
        l2 = Line(workPart, p2, p3)
        l3 = Line(workPart, p3, p4)
        l4 = Line(workPart, p4, p1)

        self.lines = [l1, l2, l3, l4]
        curves = []
        for line in self.lines:
            curves.extend(line.curves)
        super().__init__(curves)


